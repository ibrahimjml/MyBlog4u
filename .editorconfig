root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# Split these out cleanly so the parser never misses them
[*.php]
insert_final_newline = false
trim_trailing_whitespace = false

[*.blade.php]
insert_final_newline = false
trim_trailing_whitespace = false

[*.html]
insert_final_newline = false
trim_trailing_whitespace = false

[*.css]
insert_final_newline = false
trim_trailing_whitespace = false

[*.md]
trim_trailing_whitespace = false
insert_final_newline = false

[*.{yml,yaml}]
indent_size = 2

[docker-compose.yml]
indent_size = 4

